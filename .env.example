# Copy to .env and adjust. Never commit the real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
# Databases are named <DB_PREFIX>bronze / silver / gold / dq
DB_PREFIX=hotel_
# Reject a batch if more than this share of a table is quarantined
MAX_QUARANTINE_RATE=0.10
